{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM Assisted API Fuzzing Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "target", "llm", "generation", "repair", "runtime", "fuzzing", "result", "artifacts", "experiment"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "target": {"type": "object", "additionalProperties": false, "required": ["name", "protocol"], "properties": {"name": {"type": "string"}, "protocol": {"type": "string"}}},
    "llm": {"type": "object", "additionalProperties": false, "required": ["provider", "model", "usage_available", "prompt_tokens", "completion_tokens", "total_tokens", "usage_source"], "properties": {"provider": {"type": "string"}, "model": {"type": "string"}, "usage_available": {"type": "boolean"}, "prompt_tokens": {"type": ["integer", "null"], "minimum": 0}, "completion_tokens": {"type": ["integer", "null"], "minimum": 0}, "total_tokens": {"type": ["integer", "null"], "minimum": 0}, "usage_source": {"type": "string"}}},
    "generation": {"type": "object", "additionalProperties": false, "required": ["repair_count"], "properties": {"repair_count": {"type": "integer", "minimum": 0}}},
    "repair": {"type": "object", "additionalProperties": false, "required": ["attempts", "initial_valid", "final_valid", "successful"], "properties": {"attempts": {"type": "integer", "minimum": 0}, "initial_valid": {"type": ["boolean", "null"]}, "final_valid": {"type": ["boolean", "null"]}, "successful": {"type": "boolean"}}},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["total_ms", "analyzer_ms", "generation_ms", "validation_ms", "repair_ms"], "properties": {"total_ms": {"type": "number", "minimum": 0}, "analyzer_ms": {"type": "number", "minimum": 0}, "generation_ms": {"type": "number", "minimum": 0}, "validation_ms": {"type": "number", "minimum": 0}, "repair_ms": {"type": "number", "minimum": 0}}},
    "fuzzing": {"type": "object", "additionalProperties": false, "required": ["engine", "runtime_ms", "requests"], "properties": {"engine": {"type": ["string", "null"]}, "runtime_ms": {"type": "number", "minimum": 0}, "requests": {"type": "integer", "minimum": 0}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["status", "payload_count", "finding_count"], "properties": {"status": {"type": "string"}, "payload_count": {"type": "integer", "minimum": 0}, "finding_count": {"type": ["integer", "null"], "minimum": 0}}},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["context", "payloads", "findings"], "properties": {"context": {"type": "string"}, "payloads": {"type": "string"}, "findings": {"type": ["string", "null"]}}},
    "experiment": {"type": "object", "additionalProperties": false, "required": ["git_commit", "dataset_version", "config_version"], "properties": {"git_commit": {"type": ["string", "null"]}, "dataset_version": {"type": ["string", "null"]}, "config_version": {"type": ["string", "null"]}}}
  }
}